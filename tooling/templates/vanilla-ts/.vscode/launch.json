{
  "version": "0.2.0",
  "configurations": [
    {
      // Start this first, then `pnpm dev --debug`: it attaches to the next backend that starts.
      // After a rebuild, start it again and save a Pico file. Needs lldb-dap (on Linux with
      // kernel.yama.ptrace_scope 0); pico newer than 0.4.2 shows strings and arrays as values.
      "type": "pico",
      "request": "attach",
      "name": "Debug the backend",
      "program": "${workspaceFolder}/.pico-desktop/dev/backend",
      "waitFor": true
    }
  ]
}
