// Where a backend keeps what it writes (docs/tutorial.md, "Settings and caches"): one directory for
// data that must survive (settings, user files) and one for caches that may be deleted.
//
//   Linux      data   $XDG_DATA_HOME/pico-desktop/apps/<app-id>            (default ~/.local/share)
//              cache  $XDG_CACHE_HOME/pico-desktop/apps/<app-id>/backend   (default ~/.cache)
//   Windows    %LOCALAPPDATA%\pico-desktop\apps\<app-id>, with \backend for the cache
//
// An XDG variable that is empty or not an absolute path is ignored, as the XDG specification says. The
// directories are created on first use (a new one with mode 0700); one that can't be created or written
// to is an `AppDirError` naming the directory and the variable to change, not a crash. macOS and Windows
// are not tested yet.
import { chmod, exists, mkdir, remove, writeText } from "std/fs"
import { isAbsolute, join } from "std/path"
import { env, pid } from "std/process"

/// Whether this is a Windows build: it looks for %LOCALAPPDATA%, everything else for the XDG variables.
const onWindows: bool = comptime if (target.os == "windows") true else false

/// Why the directories aren't available: `InvalidAppId`, `NoHome` (no variable says where) or
/// `NotWritable` (they can't be created, or can't be written to).
export class AppDirError extends Error {
  public kind: string
  /// The directory the problem is with ("" when it is not about one).
  public path: string

  constructor(kind: string, path: string, message: string) {
    super(message)
    this.kind = kind
    this.path = path
  }
}

/// An app's directories.
export class AppDirs {
  /// For what must survive: settings, user files. Never cleaned up by the framework.
  public data: string
  /// For what can be rebuilt: downloads, indexes. The user (or the system) may delete it at any time.
  public cache: string

  constructor(data: string, cache: string) {
    this.data = data
    this.cache = cache
  }
}

/// Whether `appId` is an app ID as the configuration accepts it (pico-desktop.config.ts: lowercase letters,
/// digits, '-' and '.', each dot-separated part starting with a letter or digit, like com.example.app). The ID
/// is a directory name, so nothing else is allowed (no '/', no "..").
export function isValidAppId(appId: string): bool {
  if (appId.length == 0) {
    return false
  }
  for (const label of appId.split(".")) {
    if (!isValidLabel(label)) {
      return false
    }
  }
  true
}

/// One dot-separated part of an app ID: a-z, 0-9 and '-', not starting with '-'.
function isValidLabel(label: string): bool {
  if (label.length == 0 || label.startsWith("-")) {
    return false
  }
  for (const ch of label) {
    if (!"abcdefghijklmnopqrstuvwxyz0123456789-".includes(`${ch}`)) {
      return false
    }
  }
  true
}

/// The variable that says where `kind` ("data" or "cache") goes on this system.
function variableFor(kind: string, windows: bool): string {
  if (windows) "LOCALAPPDATA" else if (kind == "data") "XDG_DATA_HOME" else "XDG_CACHE_HOME"
}

/// An absolute path in the variable `name`, or null.
function absolute(vars: Map<string, string>, name: string): string? {
  const value = vars.get(name)
  if (value != null && value != "" && isAbsolute(value)) value else null
}

/// The base directory for `kind`: on Windows %LOCALAPPDATA%; elsewhere its XDG variable, else `fallback`
/// under the home directory. Null when nothing says.
function base(vars: Map<string, string>, kind: string, fallback: string, windows: bool): string? {
  if (windows) {
    return absolute(vars, "LOCALAPPDATA")
  }
  const wanted = absolute(vars, variableFor(kind, false))
  if (wanted != null) {
    return wanted
  }
  const home = absolute(vars, "HOME")
  if (home != null) join(home!, fallback) else null
}

/// Where the directories of `appId` are, given the environment `vars` (and whether it's Windows's).
/// Nothing is created.
export function locate(appId: string, vars: Map<string, string>, windows: bool = onWindows): AppDirs throws AppDirError {
  if (!isValidAppId(appId)) {
    throw new AppDirError("InvalidAppId", "", `'${appId}' isn't a valid app ID: use lowercase letters, digits, '-' and '.' (like com.example.app)`)
  }
  const data = base(vars, "data", ".local/share", windows)
  const cache = base(vars, "cache", ".cache", windows)
  if (data == null || cache == null) {
    const names = if (windows) "LOCALAPPDATA" else "XDG_DATA_HOME and XDG_CACHE_HOME (or HOME)"
    throw new AppDirError("NoHome", "", `no place for the app's data: set ${names} to an absolute path`)
  }
  new AppDirs(join(data!, "pico-desktop", "apps", appId), join(cache!, "pico-desktop", "apps", appId, "backend"))
}

/// Makes the probe files of this process distinct: two calls at once, or a backend still exiting during a
/// restart, must not remove each other's.
class Probes {
  public count: int = 0
}

const probes = new Probes()

/// Creates `dir` if it's missing (a new one private to the user, mode 0700), and proves it can be written
/// to by creating and removing a file of its own.
async function prepare(dir: string, variable: string): Promise<void> throws AppDirError {
  probes.count += 1
  const probe = join(dir, `.write-test-${pid}-${probes.count}`)
  try {
    const existed = await exists(dir)
    await mkdir(dir, true)
    if (!existed) {
      try {
        await chmod(dir, 448)  // 0700; where modes mean nothing (Windows) this changes nothing
      } catch (e: IoError) {}
    }
    await writeText(probe, "")
  } catch (e: IoError) {
    throw new AppDirError("NotWritable", dir, `can't use ${dir}: ${e.message}; set ${variable} to a directory you can write to`)
  }
  try {
    await remove(probe)
  } catch (e: IoError) {
    // Gone already is fine; anything else means the directory can't really be used.
    if (e.kind != "NotFound") {
      throw new AppDirError("NotWritable", dir, `can't use ${dir}: ${e.message}; set ${variable} to a directory you can write to`)
    }
  }
}

/// The app's data and cache directories, created if they don't exist and checked to be writable. Call it
/// once, when the backend starts, and keep the result.
///
/// ```
/// const dirs = await appDirs("com.example.app")
/// await writeText(join(dirs.data, "settings.json"), json)
/// ```
///
/// @throws AppDirError if the app ID is invalid, nothing says where the directories go, or a directory
/// can't be created or written to; the backend can carry on without it (say so to the user), nothing here exits.
export async function appDirs(appId: string): Promise<AppDirs> throws AppDirError {
  const dirs = locate(appId, env.toObject())
  await prepare(dirs.data, variableFor("data", onWindows))
  await prepare(dirs.cache, variableFor("cache", onWindows))
  dirs
}
