// ADR-0005: the decoders generated from the experiment contract (generated/experiment.pi) against
// the shared payload corpus: they must accept exactly the cases the TypeScript validators accept.
import { describe, it, expect } from "std/test"
import { readText, exists } from "std/fs"
import { hex } from "std/encoding"
import { decode, encode } from "./cbor"
import { InvalidPayload } from "./payload"
import { decodeNamed, roundTripNamed } from "./generated/experiment"

struct Case {
  name: string
  type: string
  valid: bool
  hex: string
}

struct Corpus {
  cases: Case[]
}

async function corpusPath(): Promise<string> throws Error {
  const fromRoot = "packages/communicator-pico/generated/experiment-corpus.json"
  if (await exists(fromRoot)) fromRoot else "generated/experiment-corpus.json"
}

const corpus = JSON.parse<Corpus>(await readText(await corpusPath()))

function accepts(c: Case): string {
  try {
    decodeNamed(c.type, decode(hex.decode(c.hex)))
    "accepted"
  } catch (e: InvalidPayload) {
    e.message
  }
}

/// Encoding a decoded value and decoding it again gives the same bytes (the encoders write what
/// the decoders read).
function stable(c: Case): string {
  try {
    const once = roundTripNamed(c.type, decode(hex.decode(c.hex)))
    const twice = roundTripNamed(c.type, once)
    if (hex.encode(encode(once)) == hex.encode(encode(twice))) "stable" else "changed"
  } catch (e: InvalidPayload) {
    e.message
  }
}

describe("the generated Pico encoders", () => {
  for (const c of corpus.cases) {
    if (c.valid) {
      it(`round-trip ${c.name}`, () => {
        expect(stable(c)).toBe("stable")
      })
    }
  }
})

describe("the generated Pico decoders", () => {
  for (const c of corpus.cases) {
    it(`${if (c.valid) "accept" else "reject"} ${c.name}`, () => {
      const outcome = accepts(c)
      expect(if (c.valid) outcome else (if (outcome == "accepted") "accepted" else "rejected")).toBe(if (c.valid) "accepted" else "rejected")
    })
  }
})
