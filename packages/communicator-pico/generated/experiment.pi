export struct SerialPort {
  path: string
  vendorId: u16?
  productId: u16?
  serial: string?
}

export function decodeSerialPort(v: Cbor, path: string): SerialPort throws InvalidPayload {
  const m = members(v, path, ["path", "vendorId", "productId", "serial"])
  const vendorIdCbor = m.get("vendorId")
  let vendorId: u16? = null
  if (vendorIdCbor != null) {
    vendorId = (uint(vendorIdCbor, `${path}.vendorId`, 65535) as u16)
  }
  const productIdCbor = m.get("productId")
  let productId: u16? = null
  if (productIdCbor != null) {
    productId = (uint(productIdCbor, `${path}.productId`, 65535) as u16)
  }
  const serialCbor = m.get("serial")
  let serial: string? = null
  if (serialCbor != null) {
    serial = text(serialCbor, `${path}.serial`)
  }
  SerialPort {
    path: text(required(m, "path", path), `${path}.path`),
    vendorId: vendorId,
    productId: productId,
    serial: serial,
  }
}

