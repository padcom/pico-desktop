function decodeTreeChildrenList(v: Cbor, path: string): Tree[] throws InvalidPayload {
  const out: Tree[] = []
  let i = 0
  for (const e of items(v, path)) {
    out.push(decodeTree(e, `${path}[${i}]`))
    i += 1
  }
  out
}

