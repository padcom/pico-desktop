    "raw" => Packet.Raw(decodeRawPacket(v, path)),
    "text" => Packet.Text(decodeTextPacket(v, path)),
    _ => throw new InvalidPayload(`${path}.kind`, "kind raw or text"),
  }
}

export function encodePacket(v: Packet): Cbor {
  match (v) {
    Raw { value } => encodeRawPacket(value),
    Text { value } => encodeTextPacket(value),
  }
}

