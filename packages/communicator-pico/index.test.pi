import { describe, it, expect } from "std/test"
import { PROTOCOL_VERSION, FRAME_HEADER_BYTES, initialState } from "./index"

function versions(): void {
  expect(PROTOCOL_VERSION).toBe(0)
  expect(FRAME_HEADER_BYTES).toBe(4)
}

function startsConnecting(): void {
  expect(initialState() == "connecting").toBe(true)
}

describe("communicator", () => {
  it("matches the TypeScript protocol constants", versions)
  it("starts in the connecting state", startsConnecting)
})
