// The Pico side of the Communicator: typed string-keyed RPC, events and managed subscriptions to
// the TypeScript frontend through the native host (docs/protocol.md; the Communicator itself is F3).
//
// Pico 0.4 has no async closures (pico-lang #52), so handlers will be named async functions or
// methods returning a Promise, never `async (payload) => …` lambdas.
export { Cbor, CborError, MAX_DEPTH, decode, encode, integer, diagnostic } from "./cbor"
export {
  Envelope,
  ErrorInfo,
  MessageKind,
  MESSAGE_KINDS,
  MAX_ID,
  MAX_NAME_BYTES,
  PROTOCOL_VERSION,
  ProtocolError,
  decodeEnvelope,
  encodeEnvelope,
  envelope,
} from "./envelope"
export { FRAME_HEADER_BYTES, FrameReader, encodeFrame } from "./framing"

/// Observable connection states (docs/protocol.md §7).
export type ConnectionState = "connecting" | "ready" | "disconnected" | "restarting" | "failed" | "closing"

/// The state a new Communicator starts in.
export function initialState(): ConnectionState {
  "connecting"
}
