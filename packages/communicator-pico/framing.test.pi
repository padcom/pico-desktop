import { describe, it, expect } from "std/test"
import { FrameReader, encodeFrame } from "./framing"
import { ProtocolError } from "./envelope"

function bytes(n: int, fill: int): Uint8Array {
  const b = new Uint8Array(n)
  for (let i = 0; i < n; i++) {
    b.set(i, fill)
  }
  b
}

function chunked(): void throws Error {
  const messages = [bytes(1, 1), bytes(70000, 7), bytes(5, 3)]
  let total = 0
  for (const m of messages) {
    total += 4 + m.length
  }
  const stream = new Uint8Array(total)
  let at = 0
  for (const m of messages) {
    const f = encodeFrame(m)
    stream.setAll(f, at)
    at += f.length
  }
  for (const size of [1, 3, 4, 5, 1000, total]) {
    const reader = new FrameReader()
    const out: Uint8Array[] = []
    for (let i = 0; i < total; i += size) {
      reader.push(stream.subarray(i, if (i + size > total) total else i + size))
      let m = reader.next()
      while (m != null) {
        out.push(m)
        m = reader.next()
      }
    }
    expect(out.length).toBe(3)
    expect(out[1].length).toBe(70000)
    expect(out[1].get(69999)).toBe(7)
    expect(out[2].get(4)).toBe(3)
    expect(reader.pending).toBe(0)
  }
}

function codeOf(reader: FrameReader, chunk: Uint8Array): string {
  reader.push(chunk)
  try {
    reader.next()
    "accepted"
  } catch (e: ProtocolError) {
    e.code
  }
}

function limits(): void throws Error {
  expect(codeOf(new FrameReader(), Uint8Array.from([0, 0, 0, 0]))).toBe("INVALID_MESSAGE")
  expect(codeOf(new FrameReader(1024), Uint8Array.from([0, 0, 4, 1]))).toBe("MESSAGE_TOO_LARGE")
  const failed = new FrameReader()
  codeOf(failed, Uint8Array.from([0, 0, 0, 0]))
  expect(codeOf(failed, encodeFrame(bytes(1, 1)))).toBe("INVALID_MESSAGE")
}

describe("framing", () => {
  it("reassembles messages from any chunking", chunked)
  it("rejects zero and oversized frames, and stays failed", limits)
})
