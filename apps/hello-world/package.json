{
  "name": "@pico-desktop/hello-world",
  "version": "0.0.0",
  "private": true,
  "description": "The F3 vertical slice: a Vite frontend and a Pico backend talking typed CBOR through the CEF host",
  "author": "Matthias Hryniszak <padcom@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "vite build frontend",
    "build:self-test": "vite build frontend --mode self-test",
    "backend": "cd backend && pico build --release \"$PWD/main.pi\" -o ../dist/backend",
    "backend:test": "cd backend && pico test \"$PWD\" && pico lint \"$PWD\"",
    "start": "pnpm build && pnpm backend && ../../build/cef/runtime/cef-host/pico-desktop-host --app-dir=dist/frontend --app-id=dev.pico-desktop.hello-world --backend=dist/backend",
    "self-test": "pnpm build:self-test && pnpm backend && scripts/self-test.sh ../../build/cef/runtime/cef-host/pico-desktop-host",
    "typecheck": "tsc -p frontend",
    "test": "vitest run --root frontend"
  },
  "dependencies": {
    "@pico-desktop/communicator": "workspace:*",
    "@pico-desktop/protocol": "workspace:*"
  },
  "devDependencies": {
    "@pico-desktop/schema-tooling": "workspace:*"
  }
}
