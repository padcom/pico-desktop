// The hello-world backend: greets (counting greetings), asks the frontend before greeting when
// told to, tells the window after each greeting, and publishes a clock. Pico 0.4 has no async
// closures, so handlers are named async functions sharing the module's state.
import { Cbor, Communicator, CommunicatorError, Host, RequestContext, Sink, Transport } from "pico-desktop/communicator"
import {
  BenchEvent,
  BytesEcho,
  ConfirmRequest,
  Greeted,
  Greeting,
  Picked,
  Tick,
  WindowTitle,
  decodeBenchParams,
  decodeBytesMessage,
  decodeClockParams,
  decodeConfirmResponse,
  decodeHelloRequest,
  decodeWindowTitle,
  encodeBenchEvent,
  encodeBytesEcho,
  encodeConfirmRequest,
  encodeGreeted,
  encodeGreeting,
  encodePicked,
  encodeTick,
  encodeWindowTitle,
} from "./generated/hello"

class State {
  public communicator: Communicator? = null
  public host: Host? = null
  public greetings: u32 = 0
}

const state = new State()

/// The backend on `transport` (the app runs it on stdio; tests on a memory link).
export function createBackend(transport: Transport): Communicator {
  const c = new Communicator(transport)
  state.communicator = c
  state.host = new Host(c)
  state.greetings = 0
  c.handle("greeting.hello", hello)
  c.handle("greeting.ask", ask)
  c.handle("window.retitle", retitle)
  c.handle("files.pick", pick)
  c.handle("data.echo", echoBytes)
  c.publish("clock.ticks", ticks)
  c.publish("bench.events", benchEvents)
  c
}

function communicator(): Communicator {
  const c = state.communicator
  if (c == null) {
    panic("hello-world: createBackend wasn't called")
  }
  c
}

/// "Hello, <name>!" (a name is required), counted, and announced to the window that asked.
async function greet(name: string, window: u64?): Promise<Greeting> throws Error {
  const trimmed = name.trim()
  if (trimmed.length == 0) {
    throw new CommunicatorError("EMPTY_NAME", "say who to greet")
  }
  state.greetings += 1
  const greeting = Greeting { message: `Hello, ${trimmed}!`, count: state.greetings }
  await communicator().emit("greeting.greeted", encodeGreeted(Greeted { name: trimmed, count: greeting.count }), window)
  greeting
}

async function hello(payload: Cbor?, ctx: RequestContext): Promise<Cbor?> throws Error {
  const request = decodeHelloRequest(payload ?? Cbor.Null, "$")
  encodeGreeting(await greet(request.name, ctx.window))
}

/// Asks the frontend first (a backend → frontend call), then greets, or doesn't.
async function ask(payload: Cbor?, ctx: RequestContext): Promise<Cbor?> throws Error {
  const request = decodeHelloRequest(payload ?? Cbor.Null, "$")
  const question = encodeConfirmRequest(ConfirmRequest { question: `Say hello to ${request.name}?` })
  const answer = decodeConfirmResponse((await communicator().request("ui.confirm", question, ctx.window)) ?? Cbor.Null, "$")
  if (!answer.ok) {
    return encodeGreeting(Greeting { message: `Maybe later, ${request.name}.`, count: state.greetings })
  }
  encodeGreeting(await greet(request.name, ctx.window))
}

function host(): Host {
  const h = state.host
  if (h == null) {
    panic("hello-world: createBackend wasn't called")
  }
  h
}

/// Sets the window's title through the host, and answers with what the window now says.
async function retitle(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const request = decodeWindowTitle(payload ?? Cbor.Null, "$")
  await host().setTitle(request.title)
  encodeWindowTitle(WindowTitle { title: await host().getTitle() })
}

/// Opens the host's file dialog: the app doesn't declare `dialogs`, so the host refuses it.
async function pick(_payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  encodePicked(Picked { paths: await host().openFile() })
}

/// Gives the bytes back, with how many there were and their sum modulo 2^32, counted here in Pico:
/// proof of what arrived, byte for byte (a byte string is bytes in Pico, not text).
async function echoBytes(payload: Cbor?, _ctx: RequestContext): Promise<Cbor?> throws Error {
  const request = decodeBytesMessage(payload ?? Cbor.Null, "$")
  let sum: int = 0
  for (let i = 0; i < request.data.length; i++) {
    sum += request.data.get(i) as int
  }
  encodeBytesEcho(BytesEcho { data: request.data, length: request.data.length as u32, sum: (sum % 4294967296) as u32 })
}

/// The benchmark's load (docs/ipc-benchmark.md): `count` events, `perSecond` each second, each with
/// `bytes` bytes and the time it was sent. The timer ends after the last one; the subscription stays
/// open until the subscriber ends it.
class Bench {
  sink: Sink
  count: u32
  data: Uint8Array
  public n: u32 = 0
  public timer: int = 0

  constructor(sink: Sink, count: u32, bytes: int) {
    this.sink = sink
    this.count = count
    this.data = new Uint8Array(bytes)
  }

  public tick(): void {
    n += 1
    sink.next(encodeBenchEvent(BenchEvent { n: n, sentAt: Date.now() as u64, data: data }))
    if (n >= count) {
      clearInterval(timer)
    }
  }
}

function benchEvents(params: Cbor?, sink: Sink): void throws Error {
  const p = decodeBenchParams(params ?? Cbor.Null, "$")
  // The timer runs in whole milliseconds, so only a rate that divides 1000 is the rate asked for.
  if (p.perSecond < 1 || p.perSecond > 1000 || 1000 % (p.perSecond as int) != 0 || p.count < 1 || p.bytes > 2097152) {
    throw new CommunicatorError("INVALID_VALUE", "the benchmark wants a rate that divides 1000 (50, 100, ...), at least one event and at most 2 MiB each")
  }
  const bench = new Bench(sink, p.count, p.bytes as int)
  bench.timer = setInterval(() => bench.tick(), (1000 / p.perSecond) as int)
  sink.onClose = () => clearInterval(bench.timer)
}

/// A tick every `intervalMs` (default 1 s) until the subscriber unsubscribes.
class Clock {
  sink: Sink
  public n: u32 = 0
  public timer: int = 0

  constructor(sink: Sink) {
    this.sink = sink
  }

  public tick(): void {
    n += 1
    sink.next(encodeTick(Tick { n: n }))
  }
}

function ticks(params: Cbor?, sink: Sink): void throws Error {
  const interval = decodeClockParams(params ?? Cbor.Null, "$").intervalMs ?? 1000
  const clock = new Clock(sink)
  clock.timer = setInterval(() => clock.tick(), interval as int)
  sink.onClose = () => clearInterval(clock.timer)
}
